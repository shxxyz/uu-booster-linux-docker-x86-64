# 示例值；改成连接局域网的物理以太网接口，**不能是 Wi-Fi**。
UU_PARENT_INTERFACE=enp3s0

# 按服务器接口的实际子网和原默认网关填写。
UU_LAN_SUBNET=10.0.0.0/24
UU_UPSTREAM_GATEWAY=10.0.0.1

# 必须先在主路由 DHCP 地址池中排除/保留，确认没有其他设备占用。
UU_CONTAINER_IP=10.0.0.2

# 固定 MAC 可避免重建容器后 UU 绑定身份变化；必须在局域网内唯一。
UU_MAC_ADDRESS=02:42:0a:00:00:51

# 容器内 dnsmasq 的上游。可填主路由，也可填可信公共 DNS。
# 这不控制 UU 加速期间可能对游戏设备 UDP/53 执行的目标改写。
DNSMASQ_UPSTREAM=10.0.0.1

# 默认不由封装层增加 SNAT。只有确认存在回程问题后才尝试 `masquerade`；
# 这会增加一层 NAT，可能影响 PS5/Xbox/Switch 的 NAT 类型。
UU_SNAT_MODE=off

# UU 插件内置日志级别：debug / info / warning / fatal，默认 info。
# 排障时改为 debug，重新创建容器后用 docker compose logs -f uu 查看。
UU_LOG_LEVEL=info

# 可选。仅供插件包和镜像构建下载；不会作为 UU 运行时的前置代理。
# 直连失败时才尝试此代理。若填写 localhost，构建使用 host 网络，因此指向宿主机。
# DOWNLOAD_PROXY=http://localhost:7890
